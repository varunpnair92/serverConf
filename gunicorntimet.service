[Unit]
Description=gunicorn daemon fisattt
Requires=gunicorntimet.socket
After=network.target

[Service]
User=varun
Group=www-data
WorkingDirectory=/home/varun/fisattt
ExecStart=/home/varun/pscapp/bin/gunicorn \
          --access-logfile - \
          --workers 3 \
          --bind unix:/run/gunicorntimet.sock \
          fisattt.wsgi:application

[Install]
WantedBy=multi-user.target
